# Soak N Wet — contact form forwarding
# Copy to .env.local for local testing, or set these in Vercel
# (Project → Settings → Environment Variables) for production.

# From Twilio console → Account → API keys & tokens
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=your-auth-token

# The Canadian local number you bought in Twilio (E.164 format)
TWILIO_FROM_NUMBER=+16135551234

# Who gets the SMS. Comma-separated, E.164 only. Primary first.
# Primary = Pierre. Secondary = Yosef (keeps the agency in the loop
# so we can prove ROI at retainer review time).
RECIPIENT_PHONE=+16135550123,+15145550456
